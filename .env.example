# Copier ce fichier en .env et ajuster si besoin — tout a un défaut raisonnable.

# Moteur par défaut à l'upload : qwen3 (local), kyutai (local) ou elevenlabs (cloud).
# NB : le choix fait dans l'UI (banc d'essai des voix) prime sur cette valeur.
DEFAULT_ENGINE=qwen3

# Langue par défaut à l'upload (fr ou en)
DEFAULT_LANGUAGE=fr

# Dossier des données (sources, textes, audios, voix). Défaut : <repo>/data
#DATA_DIR=

# ------------------------------------------------------------- sortie audio
#MP3_BITRATE=96k
#M4B_BITRATE=64k

# ------------------------------------------- moteur local qwen3 (mlx-audio)
#QWEN3_BASE_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-bf16
#QWEN3_CUSTOM_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-bf16
#QWEN3_VOICE_DESIGN_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-bf16
#QWEN3_TEMPERATURE=0.7

# --------------------- moteur local kyutai (venv isolé .venv-kyutai, fr/en)
#KYUTAI_REPO=kyutai/tts-1.6b-en_fr
#KYUTAI_VOICE_REPO=kyutai/tts-voices
#KYUTAI_TEMP=0.6
#KYUTAI_CFG_COEF=2.0
#KYUTAI_LOAD_TIMEOUT=1800
#KYUTAI_SYNTH_TIMEOUT=900

# ----------------------------------------------- ElevenLabs (cloud, payant)
# Clé API (https://elevenlabs.io -> Profil -> API Key). Vide = moteur masqué.
ELEVENLABS_API_KEY=
#ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
#ELEVENLABS_MODEL_ID=eleven_multilingual_v2
#CHUNK_MAX_CHARS=4000
#VOICE_STABILITY=0.5
#VOICE_SIMILARITY_BOOST=0.75
#MONTHLY_QUOTA_CHARS=100000

# ------------------------------------------------------------------- divers
#MAX_UPLOAD_MB=100
#MIN_FREE_DISK_MB=500
