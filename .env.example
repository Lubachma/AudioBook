# Copier ce fichier en .env et remplir les valeurs

# Clé API ElevenLabs (https://elevenlabs.io -> Profil -> API Key)
ELEVENLABS_API_KEY=

# ID de la voix ElevenLabs (défaut : Rachel). Remplacer par l'ID de votre voix clonée le moment venu.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Modèle TTS multilingue (FR + EN)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Langue par défaut à l'upload (fr ou en)
DEFAULT_LANGUAGE=fr

# Moteur TTS par défaut dans l'interface : "edge" (gratuit, illimité) ou "elevenlabs"
DEFAULT_ENGINE=edge

# Voix edge-tts par défaut (ex : fr-FR-DeniseNeural, fr-FR-HenriNeural, fr-CA-SylvieNeural)
DEFAULT_EDGE_VOICE=fr-FR-DeniseNeural

# Taille max d'un chunk TTS en caractères (limite API ~5000, marge de sécurité)
CHUNK_MAX_CHARS=4000

# Taille max d'un PDF uploadé en Mo
MAX_UPLOAD_MB=100

# Réglages de voix ElevenLabs (0.0 - 1.0)
VOICE_STABILITY=0.5
VOICE_SIMILARITY_BOOST=0.75

# Quota mensuel de votre plan ElevenLabs (pour l'estimation affichée)
MONTHLY_QUOTA_CHARS=100000

# Espace disque libre minimum requis avant conversion (Mo)
MIN_FREE_DISK_MB=500
